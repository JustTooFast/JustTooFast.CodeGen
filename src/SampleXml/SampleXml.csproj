<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>JustTooFast.CodeGen.SampleXml</AssemblyName>
    <RootNamespace>JustTooFast.CodeGen.SampleXml</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="..\..\SolutionInfo.cs" Link="Properties\SolutionInfo.cs" />

    <!-- Generated files -->
    <Compile Include="Output\*.gen.cs" />

    <Compile Include="AttributeEmitter.cs" />
    <Compile Include="ElementEmitter.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="../Scaffolder.Cli/Scaffolder.Cli.csproj" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition=" '$(OS)' == 'Windows_NT' ">
    <Exec Command="call $(ProjectDir)SampleXml_PreBuild.bat &quot;$(ProjectDir)&quot; &quot;$(OutputPath)&quot; &quot;JustTooFast.CodeGen.SampleXml&quot;" />
  </Target>

  <Target Name="PreBuild_unix" BeforeTargets="PreBuildEvent" Condition=" '$(OS)' == 'Unix' ">
    <MakeDir Directories="$(ProjectDir)Output" />
    <Exec Command="find &quot;$(ProjectDir)Output&quot; -maxdepth 1 -name &quot;*.gen.cs&quot; -type f -delete" />
    <Exec Command="dotnet run --project &quot;$(ProjectDir)../Scaffolder.Cli/Scaffolder.Cli.csproj&quot; -- &quot;$(ProjectDir)Input&quot; &quot;$(ProjectDir)Output&quot; &quot;JustTooFast.CodeGen.SampleXml&quot;" />
  </Target>

</Project>
