<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>JustTooFast.CodeGen.Xml</AssemblyName>
    <RootNamespace>JustTooFast.CodeGen.Xml</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="..\..\SolutionInfo.cs" Link="Properties\SolutionInfo.cs" />

    <!-- Generated files -->
    <Compile Include="Output\*.gen.cs" />

    <Compile Include="Appender.cs" />
    <Compile Include="AttributeEmitter.cs" />
    <Compile Include="EmitterBase.cs" />
    <Compile Include="ElementEmitter.cs" />
    <Compile Include="Encoding.cs" />
    <Compile Include="EnumEx.cs" />
    <Compile Include="IAppender.cs" />
    <Compile Include="IGenerator.cs" />
    <Compile Include="PrologEmitter.cs" />
    <Compile Include="RootElementEmitter.cs" />
    <Compile Include="Standalone.cs" />
    <Compile Include="XmlBuilder.cs" />
    <Compile Include="XmlEmitter.cs" />
    <Compile Include="XmlFileBuilder.cs" />
    <Compile Include="XmlFileBuilderEx.cs" />
    <Compile Include="XmlFileEmitter.cs" />
    <Compile Include="XmlFileGenerator.cs" />
    <Compile Include="XmlFileModel.cs" />
    <Compile Include="XmlFormatException.cs" />
    <Compile Include="XmlSnippetBuilder.cs" />
    <Compile Include="XmlSnippetBuilderEx.cs" />
    <Compile Include="XmlSnippetEmitter.cs" />
    <Compile Include="XmlSnippetGenerator.cs" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition=" '$(OS)' == 'Windows_NT' ">
    <Exec Command="call $(ProjectDir)Xml_PreBuild.bat &quot;$(ProjectDir)&quot; &quot;JustTooFast.Xml&quot;" />
  </Target>

  <Target Name="PreBuild_unix" BeforeTargets="PreBuildEvent" Condition=" '$(OS)' == 'Unix' ">
    <MakeDir Directories="$(ProjectDir)Output" />
    <Exec Command="find &quot;$(ProjectDir)Output&quot; -maxdepth 1 -name &quot;*.gen.cs&quot; -type f -delete" />
    <Exec Command="dotnet run --project &quot;$(ProjectDir)../Scaffolder.Cli/Scaffolder.Cli.csproj&quot; -- &quot;$(ProjectDir)Input&quot; &quot;$(ProjectDir)Output&quot; &quot;JustTooFast.CodeGen.Xml&quot;" />
  </Target>

</Project>
